@echo off
rem ── очередь обучения голосов ──────────────────────────────────────────────
rem
rem В игре двадцать пулов озвучки — по одному на расу и пол. Обучены были
rem четыре самых крупных (данмеры и имперцы), а остальным восьми расам
rem подставлялся имперский голос со сдвигом высоты. Высота совпадала, тембр
rem нет: аргонианин говорил данмером, хаджит и орк — имперцем. Отсюда
rem ощущение «голос не тот».
rem
rem Порядок в очереди — по слышимости подмены: сперва зверорасы (у них голос
rem ни на кого не похож), потом самые частые из людей.
rem
rem Один голос — примерно четыре часа на 8 ГБ. Очередь можно прерывать:
rem обучение продолжится с последнего чекпоинта, а не начнётся заново.
rem
rem ВНИМАНИЕ: видеокарту нельзя делить с llama-server. Если играешь на своей
rem модели — сначала останови сервер.

title обучение голосов morrowind-ai
cd /d "%~dp0"

set PY=piper_train_env\venv\Scripts\python.exe
set STEPS=4000

for %%P in (am af km kf nm nf bm bf) do (
    echo.
    echo ==================================================
    echo   %%P
    echo ==================================================
    "%PY%" tools\train_voices.py --only %%P --steps %STEPS%
)

echo.
echo -- ochered proydena; eksport: tools\export_voices.py --
pause >nul
