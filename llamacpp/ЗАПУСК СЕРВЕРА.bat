@echo off
rem ── llama-server для morrowind-ai ─────────────────────────────────────────
rem
rem Зачем не LM Studio: он не умеет СОХРАНЯТЬ разбор промпта на диск. А у мода
rem две разных записки — разговор с NPC и сценка между NPC, — и общего начала у
rem них НОЛЬ знаков. Значит каждая сценка стирает разбор разговорной записки, и
rem следующая реплика игрока снова платит полную цену.
rem
rem Ключи подобраны замерами, а не наугад:
rem   -np 2            ДВА СЛОТА — главное здесь. Слот это ячейка, где сервер
rem                    держит разбор промпта. Записок у мода две, разговорная
rem                    и сценочная, и общего начала у них НОЛЬ знаков. На одном
rem                    слоте каждая сценка вытирала разбор разговорной записки,
rem                    и следующая реплика читала правила мира заново.
rem                    Замерено: один слот 13.4 с на реплику, два слота 2.7 с.
rem                    Разговор садится на слот 0, сценки на слот 1 — это
rem                    задаётся в config.yaml полем slot.
rem   -c 8192          по 4096 на слот. Разговору нужно ~3300 токенов, сценке
rem                    ~500 — хватает с запасом. Больше брали (по 8192):
rem                    время то же, а запаса памяти не остаётся.
rem   -ctk/-ctv q8_0   сжатие KV-кеша. Скорости не прибавляет, но освобождает
rem                    память — а ЗАПАС ПАМЯТИ здесь второе по важности после
rem                    двух слотов. Модель занимает 6.6 из 8.2 ГБ; браузер с
rem                    видео идёт через ту же карту, и когда свободного мало,
rem                    часть модели вытесняется в системную память и время
rem                    скачет втрое. С запасом в полтора гигабайта — держится.
rem   -ngl 999         вся модель на видеокарту. Половина слоёв на процессоре
rem                    роняет скорость с 745 токенов/с до 210.
rem   --slot-save-path ради него всё и затевалось.
rem
rem ЗАМЕРЕНО на этих ключах: 40 реплик подряд со сценками между ними, медиана
rem 3.0 с, худшая 4.0 с. На одном слоте было 13.4 с.
rem
rem ВНИМАНИЕ: видеокарту нельзя делить с обучением голосов. Сначала дождись,
rem пока обучение закончится.

rem ПОРТ 8090, А НЕ 8080: восьмидесятый занимает веб-интерфейс REAPER, и
rem сервер молча не поднимался, а по адресу отвечал чужой 404.

title llama-server (morrowind-ai)
cd /d "%~dp0"

set MODEL=C:\Users\exist\.lmstudio\models\ai-sage\GigaChat3.1-10B-A1.8B-GGUF\GigaChat3.1-10B-A1.8B-q4_K_M.gguf
set SLOTS=D:\Morrowind (ReBuild)\morrowind-ai\data\slots

if not exist "%SLOTS%" mkdir "%SLOTS%"

llama-server.exe ^
  -m "%MODEL%" ^
  --alias gigachat3.1-10b-a1.8b ^
  -c 8192 ^
  -np 2 ^
  -fa on ^
  -ctk q8_0 ^
  -ctv q8_0 ^
  -ngl 999 ^
  --slot-save-path "%SLOTS%" ^
  --host 127.0.0.1 ^
  --port 8090

echo.
echo -- server ostanovlen --
pause >nul
